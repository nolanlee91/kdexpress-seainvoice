# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haibien

# JWT
JWT_SECRET=replace_with_32_char_random_string_min_32_chars

# Cloudflare R2 (Object Storage)
# Account ID: Cloudflare dashboard → góc phải → click "Account ID" để copy
# Bucket: tạo ở R2 Object Storage → "Create bucket"
# Public Base URL: bật Public Access trên bucket → lấy URL dạng https://pub-xxx.r2.dev
# Access Key + Secret: R2 → "Manage R2 API Tokens" → tạo token Object Read & Write
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=4000
